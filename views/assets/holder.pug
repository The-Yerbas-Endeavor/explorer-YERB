extends ../layout

block content
  .col-lg-12
    if error
      .alert.alert-warning= error
    .card.card-default
      .card-header
        strong Asset Portfolio
      .card-body
        p.mb-3
          span.text-muted Address: 
          a(href='/address/' + encodeURIComponent(address))= address
        .table-responsive
          table.table.table-striped.table-hover.align-middle
            thead
              tr
                th Asset
                th Type
                th.text-end Balance
                th.text-center Metadata
            tbody
              each item in balances
                tr
                  td
                    a.fw-bold(href='/asset/' + encodeURIComponent(item.asset))= item.asset
                  td= item.metadata && item.metadata.type ? item.metadata.type : '—'
                  td.text-end= item.balance
                  td.text-center
                    if item.metadata && item.metadata.has_ipfs
                      a(href=item.metadata.ipfs_url, target='_blank', rel='noopener noreferrer') IPFS
                    else
                      span.text-muted —
              if !balances || balances.length === 0
                tr
                  td.text-center.text-muted(colspan='4') This address has no indexed asset balances.
