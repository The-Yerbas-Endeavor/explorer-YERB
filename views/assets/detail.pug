extends ../layout

block content
  .col-lg-12
    if error
      .alert.alert-warning= error
    if asset
      .card.card-default.mb-3
        .card-header.d-flex.justify-content-between.align-items-center
          strong= asset.name
          span.badge.bg-primary= asset.type
        .card-body
          .row
            .col-md-3.mb-3
              .text-muted Supply
              .fs-5= asset.amount
            .col-md-2.mb-3
              .text-muted Units
              .fs-5= asset.units
            .col-md-2.mb-3
              .text-muted Holders
              .fs-5= Number(asset.holder_count || 0).toLocaleString()
            .col-md-2.mb-3
              .text-muted Reissuable
              .fs-5= asset.reissuable ? 'Yes' : 'No'
            .col-md-3.mb-3
              .text-muted IPFS
              if asset.ipfs_hash
                a(href=asset.ipfs_url target='_blank' rel='noopener noreferrer')= asset.ipfs_hash
              else
                .fs-5 No
          if asset.ipfs_hash
            hr
            .row
              .col-lg-7.mb-3.mb-lg-0
                .text-muted.mb-2 IPFS Preview
                .border.rounded.bg-light.text-center.p-2(style='min-height: 220px;')
                  img.img-fluid.rounded(
                    src=asset.ipfs_url
                    alt=asset.name + ' IPFS image preview'
                    loading='lazy'
                    referrerpolicy='no-referrer'
                    style='max-height: 520px; object-fit: contain;'
                    onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                  )
                  iframe.border-0.rounded(
                    src=asset.ipfs_url
                    title=asset.name + ' IPFS PDF preview'
                    loading='lazy'
                    referrerpolicy='no-referrer'
                    style='display:none; width:100%; height:650px; background:#fff;'
                  )
                  noscript
                    .text-muted.py-5
                      | Enable JavaScript to preview this IPFS image or PDF.
              .col-lg-5
                .text-muted.mb-2 IPFS Content
                p.mb-2
                  a.btn.btn-sm.btn-outline-primary(href=asset.ipfs_url target='_blank' rel='noopener noreferrer')
                    span.fas.fa-external-link-alt.me-1
                    | Open IPFS content
                p.small.text-muted.mb-2
                  | Images display directly. PDF documents open in the embedded browser PDF viewer.
                code.text-break= asset.ipfs_hash
          if asset.issuer && asset.issuer.length
            hr
            .text-muted Owner token address
            each issuer in asset.issuer
              div
                a(href='/address/' + encodeURIComponent(issuer))= issuer
      .card.card-default
        .card-header.d-flex.justify-content-between.align-items-center
          div
            strong Top Asset Holders
            span.text-muted.ms-2= Number(asset.holder_count || 0).toLocaleString() + ' total'
          a.btn.btn-sm.btn-outline-primary(href='/asset/' + encodeURIComponent(asset.name) + '/holders') View all holders
        .card-body
          .table-responsive
            table.table.table-striped.table-hover
              thead
                tr
                  th Rank
                  th Address
                  th.text-end Balance
                  th.text-end Ownership
              tbody
                each holder, index in asset.holder_entries
                  - const percentage = holder.percentage == null && Number(asset.total_holder_balance || 0) > 0 ? (Number(holder.balance) / Number(asset.total_holder_balance)) * 100 : Number(holder.percentage || 0)
                  tr
                    td= index + 1
                    td
                      a(href='/address/' + encodeURIComponent(holder.address))= holder.address
                      a.ms-2.small(href='/address/' + encodeURIComponent(holder.address) + '/assets') portfolio
                    td.text-end= holder.balance
                    td.text-end= percentage.toFixed(percentage >= 1 ? 2 : 4) + '%'
                if !asset.holder_entries || asset.holder_entries.length === 0
                  tr
                    td.text-center.text-muted(colspan='4') No holder records are indexed.
