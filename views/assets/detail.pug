extends ../layout

block content
  .col-lg-12
    if error
      .alert.alert-warning= error
    if asset
      .card.card-default.mb-3
        .card-header.d-flex.justify-content-between.align-items-center
          strong= asset.name
          span.badge.bg-primary= asset.type
        .card-body
          .row
            .col-md-3.mb-3
              .text-muted Supply
              .fs-5= Number(asset.amount).toLocaleString()
            .col-md-2.mb-3
              .text-muted Units
              .fs-5= asset.units
            .col-md-2.mb-3
              .text-muted Holders
              .fs-5= asset.holder_count.toLocaleString()
            .col-md-2.mb-3
              .text-muted Reissuable
              .fs-5= asset.reissuable ? 'Yes' : 'No'
            .col-md-3.mb-3
              .text-muted IPFS
              if asset.ipfs_hash
                a(href=asset.ipfs_url target='_blank' rel='noopener noreferrer')= asset.ipfs_hash
              else
                .fs-5 No
          if asset.issuer.length
            hr
            .text-muted Owner token address
            each issuer in asset.issuer
              div
                a(href='/address/' + encodeURIComponent(issuer))= issuer
      .card.card-default
        .card-header.d-flex.justify-content-between.align-items-center
          strong Asset Holders
          span.text-muted= asset.holder_count.toLocaleString() + ' total'
        .card-body
          .table-responsive
            table.table.table-striped.table-hover
              thead
                tr
                  th Address
                  th.text-end Balance
                  th.text-end Ownership
              tbody
                each holder in asset.holder_entries
                  tr
                    td
                      a(href='/address/' + encodeURIComponent(holder.address))= holder.address
                      a.ms-2.small(href='/address/' + encodeURIComponent(holder.address) + '/assets') portfolio
                    td.text-end= Number(holder.balance).toLocaleString()
                    td.text-end= holder.percentage.toFixed(holder.percentage >= 1 ? 2 : 4) + '%'
                if asset.holder_entries.length === 0
                  tr
                    td.text-center.text-muted(colspan='3') No holder records returned by the node.
          if asset.holder_pages > 1
            nav.mt-3(aria-label='Asset holder pages')
              ul.pagination.justify-content-center.mb-0
                li.page-item(class=asset.holder_page <= 1 ? 'disabled' : '')
                  a.page-link(href='/asset/' + encodeURIComponent(asset.name) + '?page=' + (asset.holder_page - 1) + '&per_page=' + asset.holder_per_page) Previous
                - const firstPage = Math.max(1, asset.holder_page - 2)
                - const lastPage = Math.min(asset.holder_pages, asset.holder_page + 2)
                - for (let pageNumber = firstPage; pageNumber <= lastPage; pageNumber++)
                  li.page-item(class=pageNumber === asset.holder_page ? 'active' : '')
                    a.page-link(href='/asset/' + encodeURIComponent(asset.name) + '?page=' + pageNumber + '&per_page=' + asset.holder_per_page)= pageNumber
                li.page-item(class=asset.holder_page >= asset.holder_pages ? 'disabled' : '')
                  a.page-link(href='/asset/' + encodeURIComponent(asset.name) + '?page=' + (asset.holder_page + 1) + '&per_page=' + asset.holder_per_page) Next
