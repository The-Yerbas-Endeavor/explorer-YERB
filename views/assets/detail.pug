extends ../layout

block content
  .col-lg-12
    if error
      .alert.alert-warning= error
    if asset
      .card.card-default.mb-3
        .card-header.d-flex.justify-content-between.align-items-center
          strong= asset.name
          span.badge.bg-primary= asset.type
        .card-body
          .row
            .col-md-3.mb-3
              .text-muted Supply
              .fs-5= Number(asset.amount).toLocaleString()
            .col-md-2.mb-3
              .text-muted Units
              .fs-5= asset.units
            .col-md-2.mb-3
              .text-muted Holders
              .fs-5= asset.holder_count.toLocaleString()
            .col-md-2.mb-3
              .text-muted Reissuable
              .fs-5= asset.reissuable ? 'Yes' : 'No'
            .col-md-3.mb-3
              .text-muted IPFS
              if asset.ipfs_hash
                a(href=asset.ipfs_url target='_blank' rel='noopener noreferrer')= asset.ipfs_hash
              else
                .fs-5 No
          if asset.issuer.length
            hr
            .text-muted Owner token address
            each issuer in asset.issuer
              div
                a(href='/address/' + encodeURIComponent(issuer))= issuer
      .card.card-default
        .card-header.d-flex.justify-content-between.align-items-center
          div
            strong Top Asset Holders
            span.text-muted.ms-2= asset.holder_count.toLocaleString() + ' total'
          a.btn.btn-sm.btn-outline-primary(href='/asset/' + encodeURIComponent(asset.name) + '/holders') View all holders
        .card-body
          .table-responsive
            table.table.table-striped.table-hover
              thead
                tr
                  th Rank
                  th Address
                  th.text-end Balance
                  th.text-end Ownership
              tbody
                each holder, index in asset.holder_entries
                  tr
                    td= index + 1
                    td
                      a(href='/address/' + encodeURIComponent(holder.address))= holder.address
                      a.ms-2.small(href='/address/' + encodeURIComponent(holder.address) + '/assets') portfolio
                    td.text-end= Number(holder.balance).toLocaleString()
                    td.text-end= holder.percentage.toFixed(holder.percentage >= 1 ? 2 : 4) + '%'
                if asset.holder_entries.length === 0
                  tr
                    td.text-center.text-muted(colspan='4') No holder records returned by the node.